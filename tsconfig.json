{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@capsule/domain/*": ["packages/domain/src/*"],
      "@capsule/db/*": ["packages/db/src/*"],
      "@capsule/api-contracts/*": ["packages/api-contracts/src/*"],
      "@capsule/ui/*": ["packages/ui/src/*"],
      "@capsule/auth/*": ["packages/auth/src/*"],
      "@capsule/media/*": ["packages/media/src/*"],
      "@capsule/observability/*": ["packages/observability/src/*"],
      "@capsule/config/*": ["packages/config/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
